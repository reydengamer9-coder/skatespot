{
  "expo": {
    "name": "SkateSpot",
    "slug": "skatespot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skatespot",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reydengamer9.skatespot"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reydengamer9.skatespot"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#0E0E10",
      "backgroundColor": "#0E0E10"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E0E10",
          "imageWidth": 160
        }
      ],
      "expo-video",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkateSpot usa tu ubicación para mostrarte skateparks cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkateSpot necesita acceso a tus fotos y videos para subir trucos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
